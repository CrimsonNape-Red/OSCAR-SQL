<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DeviceTimeCorrectionDialog</class>
 <widget class="QDialog" name="DeviceTimeCorrectionDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>900</width><height>720</height></rect>
  </property>
  <property name="windowTitle">
   <string>Time Corrections</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>6</number></property>
   <property name="margin"><number>8</number></property>

   <!-- Outer vertical splitter: top controls | bottom history -->
   <item>
    <widget class="QSplitter" name="verticalSplitter">
     <property name="orientation"><enum>Qt::Vertical</enum></property>

     <!-- TOP: horizontal splitter (device sidebar | correction editor) -->
     <widget class="QSplitter" name="mainSplitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>

      <!-- Left: the device to correct. The three panels each have a title bar (styled in the
           constructor) and a 1 px margin that leaves room for the panel border. -->
      <widget class="QFrame" name="devicePanel">
       <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
       <property name="minimumSize"><size><width>200</width><height>0</height></size></property>
       <property name="maximumSize"><size><width>400</width><height>16777215</height></size></property>
       <layout class="QVBoxLayout" name="deviceLayout">
        <property name="spacing"><number>0</number></property>
        <property name="leftMargin"><number>1</number></property><property name="topMargin"><number>1</number></property><property name="rightMargin"><number>1</number></property><property name="bottomMargin"><number>1</number></property>
        <item>
         <widget class="QLabel" name="titleDevice">
          <property name="text"><string>Select Device to Correct</string></property>
         </widget>
        </item>
        <item>
         <widget class="QTreeWidget" name="deviceSidebar">
          <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
          <property name="headerHidden"><bool>true</bool></property>
          <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAsNeeded</enum></property>
          <column><property name="text"><string>Device</string></property></column>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- Right: Correction editor — clean top-to-bottom flow, no group boxes -->
      <widget class="QFrame" name="rightPanel">
       <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
       <layout class="QVBoxLayout" name="rightOuterLayout">
        <property name="spacing"><number>0</number></property>
        <property name="leftMargin"><number>1</number></property><property name="topMargin"><number>1</number></property><property name="rightMargin"><number>1</number></property><property name="bottomMargin"><number>1</number></property>
        <item>
         <widget class="QLabel" name="titleEditor">
          <property name="text"><string>Edit Correction</string></property>
         </widget>
        </item>
        <item>
       <layout class="QVBoxLayout" name="rightLayout">
        <property name="spacing"><number>6</number></property>
        <property name="leftMargin"><number>8</number></property><property name="topMargin"><number>8</number></property><property name="rightMargin"><number>8</number></property><property name="bottomMargin"><number>8</number></property>

        <!-- Header: device name + active date -->
        <item>
         <layout class="QHBoxLayout">
          <item>
           <widget class="QLabel" name="deviceNameLabel">
            <property name="text"><string>—</string></property>
            <property name="font"><font><bold>true</bold><pointsize>11</pointsize></font></property>
            <property name="minimumSize"><size><width>0</width><height>28</height></size></property>
           </widget>
          </item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
         </layout>
        </item>

        <!-- Mode indicator -->
        <item>
         <widget class="QLabel" name="modeLabel">
          <property name="text"><string>New correction</string></property>
          <property name="minimumSize"><size><width>0</width><height>20</height></size></property>
         </widget>
        </item>

        <!-- Correction type -->
        <item>
         <layout class="QFormLayout">
          <item row="0" column="0">
           <widget class="QLabel"><property name="text"><string>Type:</string></property></widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="correctionTypeCombo">
            <item><property name="text"><string>Offset</string></property></item>
            <item><property name="text"><string>Travel</string></property></item>
            <item><property name="text"><string>DST Change</string></property></item>
            <item><property name="text"><string>Device Timezone Misconfiguration</string></property></item>
            <item><property name="text"><string>Device Reset</string></property></item>
           </widget>
          </item>
         </layout>
        </item>

        <!-- Time correction: its label with the warning about its value beside it, then
             sign toggle + direct time entry -->
        <item>
         <layout class="QHBoxLayout" name="timeLabelLayout" stretch="0,1">
          <property name="spacing"><number>12</number></property>
          <item>
           <widget class="QLabel" name="timeCorrectionLabel">
            <property name="text"><string>Time Correction</string></property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="largeDriftWarning">
            <property name="text"><string></string></property>
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout">
          <item>
           <widget class="QPushButton" name="btnOffsetSign">
            <property name="text"><string>+</string></property>
            <property name="checkable"><bool>true</bool></property>
            <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
           </widget>
          </item>
          <item>
           <widget class="BorrowingTimeEdit" name="offsetTimeEdit">
            <property name="displayFormat"><string>HH:mm:ss</string></property>
            <property name="time">
             <time><hour>0</hour><minute>0</minute><second>0</second></time>
            </property>
           </widget>
          </item>
          <item>
           <spacer>
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeType"><enum>QSizePolicy::Fixed</enum></property>
            <property name="sizeHint" stdset="0"><size><width>12</width><height>0</height></size></property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="btnApplyLastNight">
            <property name="text"><string>Reuse Previous</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnResetToZero">
            <property name="text"><string>Reset to Zero</string></property>
           </widget>
          </item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
         </layout>
        </item>

        <!-- Dates the correction covers: always visible, so the user sees what will be saved -->
        <item>
         <widget class="QLabel">
          <property name="text"><string>Dates Covered</string></property>
         </widget>
        </item>
        <item>
         <layout class="QGridLayout" name="dateRangeLayout">
          <item row="0" column="0">
           <widget class="QLabel"><property name="text"><string>From:</string></property></widget>
          </item>
          <item row="0" column="1">
           <widget class="QDateEdit" name="advStartDate">
            <property name="calendarPopup"><bool>false</bool></property>
            <property name="displayFormat"><string>yyyy-MM-dd</string></property>
            <property name="currentSection"><enum>QDateTimeEdit::DaySection</enum></property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QLabel"><property name="text"><string>To:</string></property></widget>
          </item>
          <item row="0" column="3">
           <widget class="QDateEdit" name="advEndDate">
            <property name="calendarPopup"><bool>false</bool></property>
            <property name="displayFormat"><string>yyyy-MM-dd</string></property>
            <property name="currentSection"><enum>QDateTimeEdit::DaySection</enum></property>
           </widget>
          </item>
          <item row="0" column="4">
           <widget class="QCheckBox" name="advEndDateCheck">
            <property name="text"><string>No end</string></property>
            <property name="toolTip"><string>The correction continues for every later night</string></property>
           </widget>
          </item>
          <item row="0" column="5">
           <spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer>
          </item>
         </layout>
        </item>

        <!-- Plain-language summary of what Save will store, and the day's total for this device -->
        <item>
         <widget class="QLabel" name="summaryLabel">
          <property name="text"><string></string></property>
          <property name="wordWrap"><bool>true</bool></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="totalLabel">
          <property name="text"><string></string></property>
          <property name="wordWrap"><bool>true</bool></property>
         </widget>
        </item>

        <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>

        <!-- Result of the last Save or Reuse Previous -->
        <item>
         <widget class="QLabel" name="statusLabel">
          <property name="text"><string></string></property>
          <property name="wordWrap"><bool>true</bool></property>
         </widget>
        </item>

        <!-- Save / Cancel / Clear -->
        <item>
         <layout class="QHBoxLayout">
          <item>
           <widget class="QPushButton" name="btnSaveCorrection">
            <property name="text"><string>Save</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnDiscardChanges">
            <property name="text"><string>Cancel</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnClearCorrection">
            <property name="text"><string>Clear</string></property>
           </widget>
          </item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
         </layout>
        </item>

       </layout>
        </item>
       </layout>
      </widget>
     </widget><!-- end mainSplitter -->

     <!-- BOTTOM: History panel — full width -->
     <widget class="QFrame" name="historyPanel">
      <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
      <layout class="QVBoxLayout" name="historyLayout">
       <property name="spacing"><number>0</number></property>
       <property name="leftMargin"><number>1</number></property><property name="topMargin"><number>1</number></property><property name="rightMargin"><number>1</number></property><property name="bottomMargin"><number>1</number></property>
       <item>
        <widget class="QLabel" name="titleSaved">
         <property name="text"><string>Saved Corrections</string></property>
        </widget>
       </item>
       <item>
        <layout class="QVBoxLayout" name="historyHeaderLayout">
         <property name="spacing"><number>4</number></property>
         <property name="leftMargin"><number>8</number></property><property name="topMargin"><number>6</number></property><property name="rightMargin"><number>8</number></property><property name="bottomMargin"><number>6</number></property>
         <item>
          <widget class="QLabel" name="activeDateLabel">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
             <horstretch>1</horstretch><verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="text"><string>Saved corrections.</string></property>
           <property name="wordWrap"><bool>true</bool></property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="historyActionsLayout">
           <property name="spacing"><number>12</number></property>
         <item>
          <widget class="QCheckBox" name="chkAllDevices">
           <property name="text"><string>Show all devices</string></property>
           <property name="toolTip"><string>List the corrections of every device, not only the selected one.</string></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="chkAllDays">
           <property name="text"><string>Show all days with corrections</string></property>
           <property name="toolTip"><string>List every saved correction, not only those in force on the day shown in Daily.</string></property>
          </widget>
         </item>
         <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
         <item>
          <widget class="QPushButton" name="btnShowInDaily">
           <property name="text"><string>Show in Daily</string></property>
           <property name="toolTip"><string>Show the first day the selected correction applies to in the Daily view</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnDeleteRow">
           <property name="text"><string>Delete Correction</string></property>
           <property name="toolTip"><string>Delete the selected correction</string></property>
          </widget>
         </item>
          </layout>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QTableWidget" name="historyTable">
         <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
         <property name="toolTip"><string>Click a correction to edit it. Double-click it to show its first day in the Daily view.</string></property>
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
         <property name="tabKeyNavigation"><bool>false</bool></property>
         <column><property name="text"><string>Device</string></property></column>
         <column><property name="text"><string>From</string></property></column>
         <column><property name="text"><string>To</string></property></column>
         <column><property name="text"><string>Type</string></property></column>
         <column><property name="text"><string>Correction</string></property></column>
         <column><property name="text"><string>Added</string></property></column>
        </widget>
       </item>
      </layout>
     </widget>

    </widget><!-- end verticalSplitter -->
   </item>

   <!-- Bottom row: result of Show in Daily or Delete Correction, and the close button -->
   <item>
    <layout class="QHBoxLayout">
     <item>
      <widget class="QLabel" name="listStatusLabel">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
         <horstretch>1</horstretch><verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="text"><string></string></property>
       <property name="wordWrap"><bool>true</bool></property>
       <property name="margin"><number>4</number></property>
      </widget>
     </item>
     <item>
      <widget class="QDialogButtonBox" name="buttonBox">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="standardButtons"><set>QDialogButtonBox::Close</set></property>
       <property name="sizePolicy">
        <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
         <horstretch>0</horstretch><verstretch>0</verstretch>
        </sizepolicy>
       </property>
      </widget>
     </item>
    </layout>
   </item>

  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>BorrowingTimeEdit</class>
   <extends>QTimeEdit</extends>
   <header>borrowingtimeedit.h</header>
  </customwidget>
 </customwidgets>
 <tabstops>
  <tabstop>deviceSidebar</tabstop>
  <tabstop>correctionTypeCombo</tabstop>
  <tabstop>btnOffsetSign</tabstop>
  <tabstop>offsetTimeEdit</tabstop>
  <tabstop>btnApplyLastNight</tabstop>
  <tabstop>btnResetToZero</tabstop>
  <tabstop>advStartDate</tabstop>
  <tabstop>advEndDate</tabstop>
  <tabstop>advEndDateCheck</tabstop>
  <tabstop>btnSaveCorrection</tabstop>
  <tabstop>btnDiscardChanges</tabstop>
  <tabstop>btnClearCorrection</tabstop>
  <tabstop>chkAllDevices</tabstop>
  <tabstop>chkAllDays</tabstop>
  <tabstop>btnShowInDaily</tabstop>
  <tabstop>btnDeleteRow</tabstop>
  <tabstop>historyTable</tabstop>
 </tabstops>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender><signal>rejected()</signal>
   <receiver>DeviceTimeCorrectionDialog</receiver><slot>reject()</slot>
   <hints>
    <hint type="sourcelabel"><x>410</x><y>620</y></hint>
    <hint type="destinationlabel"><x>410</x><y>320</y></hint>
   </hints>
  </connection>
 </connections>
</ui>
